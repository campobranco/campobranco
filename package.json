{
  "name": "campobranco",
  "version": "0.10.96-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "ts-node scripts/setup.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --testPathIgnorePatterns=__tests__/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test:unit && npm run test:e2e",
    "emulator": "firebase emulators:start --only firestore,auth --project demo-test",
    "test:integration": "jest __tests__/integration",
    "seed:integration": "node --loader ts-node/esm __tests__/integration/seed.ts",
    "contracts:check": "node --loader ts-node/esm scripts/contracts-check.ts",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@google-cloud/recaptcha-enterprise": "^6.3.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.3",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.562.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@playwright/test": "^1.57.0",
    "@types/google.maps": "^3.58.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "firebase-tools": "^15.6.0",
    "jest": "^30.2.0",
    "next": "^15.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "serialize-javascript": "^7.0.6",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1"
  }
}
