// ATENÇÃO: REGRA DE EDIÇÃO - Este arquivo NÃO deve ser editado sem antes discutir a alteração.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS DE AUTENTICAÇÃO E PAPÉIS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca o papel do usuário (padrão: PUBLICADOR) de forma robusta
    function getAuthRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'PUBLICADOR')
             : 'PUBLICADOR';
    }

    function isAdmin() {
      return isAuthenticated() && getAuthRole() == 'ADMIN';
    }

    function isElder() {
      return isAuthenticated() && (getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }
    
    function isServant() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function isModerator() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(domain, action) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().keys().hasAll(['permissions']) &&
             ((getUserData().permissions[domain] && getUserData().permissions[domain][action] == true) ||
              (getUserData().permissions[domain + (
                action == 'view' ? 'View' :
                action == 'create' ? 'Create' :
                action == 'edit' ? 'Edit' :
                action == 'delete' ? 'Delete' :
                action == 'manage' ? 'Manage' : ''
              )] == true));
    }

    // --- HELPERS DE CONGREGAÇÃO (ROBUSTOS) ---
    
    // Obtém o ID da congregação de um mapa de dados (exclusivo camelCase)
    function getCongId(data) {
      return data.get('congregationId', null);
    }

    // --- REGRAS POR COLEÇÃO ---

    // 1. Congregações
    match /congregations/{congregation_id} {
      allow read: if isAuthenticated(); // Restrito a usuários logados (Privacidade)
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || (isServant() && (congregation_id == getCongId(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))));
    }

    // 2. Coleção de Usuários
    match /users/{userId} {
      allow read, list: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isServant() ||
        isElder()
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isServant());
      allow delete: if isAdmin();
    }

    // 3. Cidades
    match /cities/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isServant() || hasPermission('maps', 'view') || getAuthRole() == 'PUBLICADOR' || getAuthRole() == 'PUBLICADOR_SEM_ACESSO');
      allow create: if isAdmin() || isServant() || hasPermission('maps', 'create');
      allow update: if isAdmin() || isServant() || hasPermission('maps', 'edit');
      allow delete: if isAdmin() || isServant() || hasPermission('maps', 'delete');
    }

    // 4. Territórios e Endereços
    match /territories/{id} {
      allow read, list: if isAuthenticated() && (isAdmin() || isServant() || hasPermission('maps', 'view') || getAuthRole() == 'PUBLICADOR' || getAuthRole() == 'PUBLICADOR_SEM_ACESSO');
      allow create: if isAdmin() || isServant() || hasPermission('maps', 'create');
      allow update: if isAdmin() || isServant() || hasPermission('maps', 'edit');
      allow delete: if isAdmin() || isServant() || hasPermission('maps', 'delete');
    }

    match /addresses/{id} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isServant() || hasPermission('maps', 'create');
      allow delete: if isAdmin() || isServant() || hasPermission('maps', 'delete');
      allow update: if isAuthenticated() && (
        isAdmin() || isServant() || hasPermission('maps', 'edit') || 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visit_status', 'visit_notes', 'last_visited_at', 'last_visited_by', 'notes', 'tagsSnapshot'])
      );
      
      // Subcoleção de Histórico de Endereço
      match /history/{histId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // 5. Visitas (Histórico Individual)
    match /visits/{id} {
      allow read: if true; // Permitir leitura pública para histórico em listas compartilhadas
      allow create: if isAuthenticated(); // Escrita apenas para usuários autenticados
      allow update, delete: if isAuthenticated();
    }

    // 6. Listas Compartilhadas (Cartões)
    match /shared_lists/{id} {
      // Regras específicas para registros S-13 (title == 'Registro Manual')
      allow read: if true; // Leitura pública via link
      allow create: if isAuthenticated() && (
        request.resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'create')
        ) : true
      );
      allow update: if isAuthenticated() && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'edit')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'delete')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid
        )
      );

      // Subcoleções de Listas
      match /items/{item_id} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /territory_addresses/{addrId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /results/{resultId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // 7. Snapshots de Listas (Públicos)
    match /shared_list_snapshots/{snapId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (isAdmin() || isServant() || getAuthRole() == 'PUBLICADOR');
      allow delete: if isAdmin() || isServant();
      
      match /visits/{id} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // 8. Pontos de Testemunho
    match /witnessing_points/{pointId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isServant() || hasPermission('witnessing', 'create');
      allow update: if isAuthenticated() && (isModerator() || hasPermission('witnessing', 'edit') || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUsers', 'status', 'updatedAt', 'currentPublishers']));
      allow delete: if isModerator() || hasPermission('witnessing', 'delete');
    }

    // 8.1. Pontos de Referência
    match /reference_points/{pointId} {
      allow read: if true; // Permitir leitura pública para que apareça em links compartilhados públicos
      allow create: if isAdmin() || isServant() || hasPermission('referencePoints', 'manage');
      allow update: if isAdmin() || isServant() || hasPermission('referencePoints', 'manage');
      allow delete: if isAdmin() || isServant() || hasPermission('referencePoints', 'manage');
    }

    // 9. Miscelânea (Logs, Reports, etc)
    match /notification_templates/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /error_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /security_logs/{id} {
      allow create: if isAuthenticated(); // Requer autenticação (Prevenção de Spam/DoW)
      allow read, update: if isAdmin();
    }

    match /lgpd_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /lgpd_requests/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    // Fallback: Bloqueia tudo que não foi explicitamente permitido
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
