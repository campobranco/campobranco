// ATENÇÃO: REGRA DE EDIÇÃO - Este arquivo NÃO deve ser editado sem antes discutir a alteração.
// Última revisão de segurança: v0.9.43-beta (18/06/2026)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS DE AUTENTICAÇÃO E PAPÉIS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca o papel do usuário (padrão: PUBLICADOR) de forma robusta.
    // O bootstrap do primeiro admin é feito via NEXT_PUBLIC_MASTER_EMAIL no AuthContext,
    // que cria o documento users/{uid} com role: 'ADMIN' no Firestore.
    function getAuthRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'PUBLICADOR')
             : 'PUBLICADOR';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getAuthRole() == 'ADMIN' || 
        getAuthRole() == 'SUPER_ADMIN' ||
        getAuthRole() == 'ANCIAO' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'campobrancojw@gmail.com')
      );
    }

    function isElder() {
      return isAuthenticated() && (getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }
    
    function isServant() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function isModerator() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(domain, action) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().keys().hasAll(['permissions']) &&
             ((getUserData().permissions[domain] && getUserData().permissions[domain][action] == true) ||
              (getUserData().permissions[domain + (
                action == 'view' ? 'View' :
                action == 'create' ? 'Create' :
                action == 'edit' ? 'Edit' :
                action == 'delete' ? 'Delete' :
                action == 'manage' ? 'Manage' : ''
              )] == true));
    }

    // --- HELPERS DE CONGREGAÇÃO (ROBUSTOS) ---
    
    // Obtém o ID da congregação de um mapa de dados (exclusivo camelCase)
    function getCongId(data) {
      return data.get('congregationId', null);
    }

    // Verifica se o recurso pertence à mesma congregação do usuário autenticado (ou se o usuário é Admin global).
    // Usado para isolamento multi-tenant em coleções que possuem congregationId.
    function isSameCongregation(resourceData) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getCongId(getUserData()) == getCongId(resourceData)
        )
      );
    }

    // --- REGRAS POR COLEÇÃO ---

    // 1. Congregações
    match /congregations/{congregation_id} {
      // Leitura para usuários logados ou convidados acessando congregações com token de convite ativo (uso seguro de .get)
      allow read: if isAuthenticated() || (resource != null && resource.data.get('inviteToken', null) != null);
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || (isServant() && (congregation_id == getCongId(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))));
    }

    // 2. Coleção de Usuários
    // Segurança: Field-level restrictions impedem auto-promoção de papel e alteração de permissões não autorizada.
    // Isolamento: Anciãos/Servos só leem/editam usuários da mesma congregação.
    match /users/{userId} {
      allow read, list: if isAuthenticated() && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && request.auth.token.email.lower() == 'campobrancojw@gmail.com') ||
        isAdmin() || 
        ((isServant() || isElder()) && isSameCongregation(resource.data))
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        ((isElder() || isServant()) && isSameCongregation(request.resource.data))
      );
      allow update: if isAuthenticated() && (
        // Admin global pode alterar qualquer campo de qualquer usuário
        isAdmin() ||

        // 1. Autoedição de Perfil: próprio usuário pode alterar nome/foto, MAS nunca role, permissions ou congregationId
        (
          request.auth.uid == userId &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('permissions' in request.resource.data.diff(resource.data).affectedKeys()) &&
          (
            !('congregationId' in request.resource.data.diff(resource.data).affectedKeys()) ||
            (
              resource.data.get('congregationId', null) == null &&
              request.resource.data.get('congregationId', null) != null
            )
          )
        ) ||

        // 2. Ancião da mesma congregação alterando PERMISSÕES DETALHADAS:
        // - Proibida a autoedição de permissões (request.auth.uid != userId)
        // - Alvo deve pertencer à mesma congregação
        // - Operação não pode alterar role, congregationId, email ou outros campos simultaneamente
        (
          isElder() &&
          isSameCongregation(resource.data) &&
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'updatedAt'])
        ) ||

        // 3. Ancião da mesma congregação PROMOVENDO OU REBAIXANDO CARGO:
        // - Proibida a autoedição (request.auth.uid != userId)
        // - Alvo deve pertencer à mesma congregação
        // - Alvo não pode ser ADMIN
        // - Transições permitidas: PUBLICADOR <-> SERVO, ou ANCIAO -> SERVO (apenas para quem já era da mesma congregação)
        // - Proibido definir cargo como ADMIN
        // - Operação não pode alterar permissions nem congregationId simultaneamente
        (
          isElder() &&
          isSameCongregation(resource.data) &&
          request.auth.uid != userId &&
          resource.data.get('role', 'PUBLICADOR') != 'ADMIN' &&
          (
            // Promover PUBLICADOR -> SERVO
            (resource.data.get('role', 'PUBLICADOR') == 'PUBLICADOR' && request.resource.data.get('role', 'PUBLICADOR') == 'SERVO') ||
            // Rebaixar SERVO -> PUBLICADOR
            (resource.data.get('role', 'PUBLICADOR') == 'SERVO' && request.resource.data.get('role', 'PUBLICADOR') == 'PUBLICADOR') ||
            // Rebaixar ANCIAO -> SERVO
            (resource.data.get('role', 'PUBLICADOR') == 'ANCIAO' && request.resource.data.get('role', 'PUBLICADOR') == 'SERVO')
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        ) ||

        // 4. Ancião da mesma congregação REMOVENDO MEMBRO (DESVINCULANDO):
        // - Proibida a autoedição (request.auth.uid != userId)
        // - Alvo pertencia comprovadamente à mesma congregação antes da remoção
        // - Alvo não pode ser ADMIN ou ANCIAO (apenas PUBLICADOR ou SERVO podem ser desvinculados por Ancião local)
        // - Transição estrita: congregationId -> null, role -> PUBLICADOR, permissions -> {} (ou ausente)
        // - Operação não pode conter campos arbitrários adicionais
        (
          isElder() &&
          isSameCongregation(resource.data) &&
          request.auth.uid != userId &&
          (resource.data.get('role', 'PUBLICADOR') == 'PUBLICADOR' || resource.data.get('role', 'PUBLICADOR') == 'SERVO') &&
          request.resource.data.get('congregationId', null) == null &&
          request.resource.data.get('role', 'PUBLICADOR') == 'PUBLICADOR' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['congregationId', 'role', 'permissions', 'updatedAt'])
        ) ||

        // 5. Servo da mesma congregação editando campos cadastrais básicos (sem permissão de tocar em role, permissions ou congregação)
        (
          isServant() &&
          isSameCongregation(resource.data) &&
          request.auth.uid != userId &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('permissions' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('congregationId' in request.resource.data.diff(resource.data).affectedKeys())
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Cidades
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /cities/{id} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow update: if (isAdmin() || isServant() || hasPermission('maps', 'edit')) && isSameCongregation(resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
    }

    // 4. Territórios
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /territories/{id} {
      allow read, list: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (
        (isAdmin() || isServant() || hasPermission('maps', 'edit')) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activeLinkIds', 'assignedToUsers', 'activeLinkId', 'assignedTo', 'updatedAt'])
      );
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
    }

    // 5. Endereços
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /addresses/{id} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (
        isAdmin() || isServant() || hasPermission('maps', 'edit') || 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visit_status', 'visit_notes', 'last_visited_at', 'last_visited_by', 'notes', 'tagsSnapshot'])
      );
      
      // Subcoleção de Histórico de Endereço
      match /history/{histId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // 6. Visitas (Histórico Individual)
    // Segurança: Leitura restrita a usuários autenticados (LGPD).
    // Links públicos exibem mapa e endereços, mas NÃO o histórico de visitas.
    match /visits/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 7. Listas Compartilhadas (Cartões)
    // Leitura pública mantida (links compartilhados sem login).
    // Isolamento: Escritas restritas à mesma congregação.
    match /shared_lists/{id} {
      allow get: if true; // Leitura pública via link
      allow list: if isAdmin() || isServant();
      allow create: if isAuthenticated() && (
        request.resource.data.get('title', '') == 'Registro Manual' ? (
          (isAdmin() || isServant() || hasPermission('s13', 'create')) && isSameCongregation(request.resource.data)
        ) : (
          isSameCongregation(request.resource.data)
        )
      );
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'edit')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedTo', 'assignedName', 'updatedAt', 'returnedAt', 'expiresAt'])
        )
      );
      allow delete: if isAuthenticated() && isSameCongregation(resource.data) && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'delete')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid
        )
      );

      // Subcoleções de Listas
      match /items/{item_id} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /territory_addresses/{addrId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /results/{resultId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }


    // 8. Snapshots de Listas (Públicos)
    // Isolamento: Escritas restritas à mesma congregação.
    match /shared_list_snapshots/{snapId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isAuthenticated() && (isAdmin() || isServant() || getAuthRole() == 'PUBLICADOR') && isSameCongregation(request.resource.data);
      allow delete: if (isAdmin() || isServant()) && isSameCongregation(resource.data);
      
      match /visits/{id} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // 9. Pontos de Testemunho
    // Isolamento: Escritas restritas à mesma congregação.
    match /witnessing_points/{pointId} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('witnessing', 'create')) && isSameCongregation(request.resource.data);
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (isModerator() || hasPermission('witnessing', 'edit') || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUsers', 'status', 'updatedAt', 'currentPublishers']));
      allow delete: if (isModerator() || hasPermission('witnessing', 'delete')) && isSameCongregation(resource.data);
    }

    // 9.1. Pontos de Referência
    // Isolamento: Escritas restritas à mesma congregação.
    match /reference_points/{pointId} {
      allow get: if true; // Permitir leitura pública para que apareça em links compartilhados públicos
      allow list: if isAdmin() || isServant();
      allow create: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(request.resource.data);
      allow update: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(resource.data);
    }

    // 10. Miscelânea (Logs, Reports, etc)
    match /notification_templates/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow get: if true;
      allow list: if isAdmin() || isServant() || hasPermission('reports', 'view');
      allow write: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /error_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /settings/{id} {
      allow get: if true;
      allow list: if isAdmin() || isServant();
      allow write: if isAdmin();
    }

    match /security_logs/{id} {
      allow create: if isAuthenticated(); // Requer autenticação (Prevenção de Spam/DoW)
      allow read, update: if isAdmin();
    }

    match /lgpd_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /lgpd_requests/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /system_logs/{id} {
      allow create, read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Fallback: Bloqueia tudo que não foi explicitamente permitido
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
