// ATENÇÃO: REGRA DE EDIÇÃO - Este arquivo NÃO deve ser editado sem antes discutir a alteração.
// Última revisão de segurança: v0.9.43-beta (18/06/2026)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS DE AUTENTICAÇÃO E PAPÉIS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca o papel do usuário (padrão: PUBLICADOR) de forma robusta.
    // O bootstrap do primeiro admin é feito via NEXT_PUBLIC_MASTER_EMAIL no AuthContext,
    // que cria o documento users/{uid} com role: 'ADMIN' no Firestore.
    function getAuthRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'PUBLICADOR')
             : 'PUBLICADOR';
    }

    function isAdmin() {
      return isAuthenticated() && getAuthRole() == 'ADMIN';
    }

    function isElder() {
      return isAuthenticated() && (getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }
    
    function isServant() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function isModerator() {
      return isAuthenticated() && (getAuthRole() == 'SERVO' || getAuthRole() == 'ANCIAO' || getAuthRole() == 'ADMIN');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(domain, action) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().keys().hasAll(['permissions']) &&
             ((getUserData().permissions[domain] && getUserData().permissions[domain][action] == true) ||
              (getUserData().permissions[domain + (
                action == 'view' ? 'View' :
                action == 'create' ? 'Create' :
                action == 'edit' ? 'Edit' :
                action == 'delete' ? 'Delete' :
                action == 'manage' ? 'Manage' : ''
              )] == true));
    }

    // --- HELPERS DE CONGREGAÇÃO (ROBUSTOS) ---
    
    // Obtém o ID da congregação de um mapa de dados (exclusivo camelCase)
    function getCongId(data) {
      return data.get('congregationId', null);
    }

    // Verifica se o recurso pertence à mesma congregação do usuário autenticado.
    // Usado para isolamento multi-tenant em coleções que possuem congregationId.
    function isSameCongregation(resourceData) {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() &&
             exists(userDoc) &&
             get(userDoc).data.get('congregationId', null) == resourceData.get('congregationId', null);
    }



    // Helper para verificar se campos restritos não foram alterados no update de usuário
    function isImmutableUserUpdate() {
      return !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
             !('permissions' in request.resource.data.diff(resource.data).affectedKeys()) &&
             !('congregationId' in request.resource.data.diff(resource.data).affectedKeys()) &&
             !('createdAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
             !('inviteTokenUsed' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // --- REGRAS POR COLEÇÃO ---

    // 1. Congregações
    match /congregations/{congregation_id} {
      allow read: if isAuthenticated(); // Restrito a usuários logados (Privacidade)
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || (isServant() && (congregation_id == getCongId(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))));
    }

    // 2. Coleção de Usuários
    // Segurança: Field-level restrictions impedem auto-promoção de papel.
    // Isolamento: Servos/Anciãos só leem/editam usuários da mesma congregação.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        getAuthRole() == 'ADMIN' || 
        ((isServant() || isElder()) && isSameCongregation(resource.data))
      );
      allow list: if isAuthenticated() && (
        getAuthRole() == 'ADMIN' || 
        ((isServant() || isElder()) && isSameCongregation(resource.data))
      );
      allow create: if isAuthenticated() && 
                    request.auth.uid == userId &&
                    request.resource.data.role == 'PUBLICADOR';
      allow update: if isAuthenticated() && (
        // Admin pode alterar qualquer campo de qualquer usuário
        isAdmin() ||
        // Próprio usuário pode atualizar seu perfil se mantiver os campos imutáveis e sincronizar o e-mail
        (
          request.auth.uid == userId &&
          isImmutableUserUpdate() &&
          (!('email' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.get('email', '') == request.auth.token.get('email', ''))
        ) ||
        // Servo/Ancião da mesma congregação pode editar, MAS não pode alterar campos privilegiados
        (
          isServant() &&
          isSameCongregation(resource.data) &&
          isImmutableUserUpdate() &&
          (!('email' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.get('email', '') == resource.data.get('email', ''))
        )
      );
      allow delete: if isAdmin();
    }

    // 3. Cidades
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /cities/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isServant() || hasPermission('maps', 'view') || getAuthRole() == 'PUBLICADOR' || getAuthRole() == 'PUBLICADOR_SEM_ACESSO');
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow update: if (isAdmin() || isServant() || hasPermission('maps', 'edit')) && isSameCongregation(resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
    }

    // 4. Territórios
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /territories/{id} {
      allow read, list: if isAuthenticated() && (isAdmin() || isServant() || hasPermission('maps', 'view') || getAuthRole() == 'PUBLICADOR' || getAuthRole() == 'PUBLICADOR_SEM_ACESSO');
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow update: if (isAdmin() || isServant() || hasPermission('maps', 'edit')) && isSameCongregation(resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
    }

    // 5. Endereços
    // Isolamento: Escritas restritas à mesma congregação do usuário.
    match /addresses/{id} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('maps', 'create')) && isSameCongregation(request.resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('maps', 'delete')) && isSameCongregation(resource.data);
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (
        isAdmin() || isServant() || hasPermission('maps', 'edit') || 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visit_status', 'visit_notes', 'last_visited_at', 'last_visited_by', 'notes', 'tagsSnapshot'])
      );
      
      // Subcoleção de Histórico de Endereço
      match /history/{histId} {
        allow read, write: if isAuthenticated() && (isAdmin() || (exists(/databases/$(database)/documents/addresses/$(id)) && isSameCongregation(get(/databases/$(database)/documents/addresses/$(id)).data)));
      }
    }

    // 6. Visitas (Histórico Individual)
    // Segurança: Leitura restrita a usuários autenticados da mesma congregação.
    match /visits/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isSameCongregation(resource.data));
      allow create: if isAuthenticated() && (isAdmin() || isSameCongregation(request.resource.data));
      allow update: if isAuthenticated() && (isAdmin() || (
        isSameCongregation(resource.data) &&
        !('congregationId' in request.resource.data.diff(resource.data).affectedKeys())
      ));
      allow delete: if isAuthenticated() && (isAdmin() || isSameCongregation(resource.data));
    }

    // 7. Listas Compartilhadas (Cartões)
    // Leitura pública mantida (links compartilhados sem login).
    // Isolamento: Escritas restritas à mesma congregação.
    match /shared_lists/{id} {
      allow read: if true; // Leitura pública via link
      allow create: if isAuthenticated() && (
        request.resource.data.get('title', '') == 'Registro Manual' ? (
          (isAdmin() || isServant() || hasPermission('s13', 'create')) && isSameCongregation(request.resource.data)
        ) : (
          isSameCongregation(request.resource.data)
        )
      );
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'edit')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid
        )
      );
      allow delete: if isAuthenticated() && isSameCongregation(resource.data) && (
        resource.data.get('title', '') == 'Registro Manual' ? (
          isAdmin() || isServant() || hasPermission('s13', 'delete')
        ) : (
          isAdmin() || isServant() || resource.data.get('createdBy', null) == request.auth.uid
        )
      );

      // Subcoleções de Listas
      match /items/{item_id} {
        allow read: if true;
        allow write: if isAuthenticated() && (isAdmin() || (exists(/databases/$(database)/documents/shared_lists/$(id)) && isSameCongregation(get(/databases/$(database)/documents/shared_lists/$(id)).data)));
      }
      match /territory_addresses/{addrId} {
        allow read: if true;
        allow write: if isAuthenticated() && (isAdmin() || (exists(/databases/$(database)/documents/shared_lists/$(id)) && isSameCongregation(get(/databases/$(database)/documents/shared_lists/$(id)).data)));
      }
      match /results/{resultId} {
        allow read: if true;
        allow write: if isAuthenticated() && (isAdmin() || (exists(/databases/$(database)/documents/shared_lists/$(id)) && isSameCongregation(get(/databases/$(database)/documents/shared_lists/$(id)).data)));
      }
    }


    // 8. Snapshots de Listas (Públicos)
    // Isolamento: Escritas restritas à mesma congregação.
    match /shared_list_snapshots/{snapId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (isAdmin() || isServant() || getAuthRole() == 'PUBLICADOR') && isSameCongregation(request.resource.data);
      allow delete: if (isAdmin() || isServant()) && isSameCongregation(resource.data);
      
      match /visits/{id} {
        allow read: if true;
        allow write: if isAuthenticated() && (isAdmin() || (exists(/databases/$(database)/documents/shared_list_snapshots/$(snapId)) && isSameCongregation(get(/databases/$(database)/documents/shared_list_snapshots/$(snapId)).data)));
      }
    }

    // 9. Pontos de Testemunho
    // Isolamento: Escritas restritas à mesma congregação.
    match /witnessing_points/{pointId} {
      allow read: if isAuthenticated();
      allow create: if (isAdmin() || isServant() || hasPermission('witnessing', 'create')) && isSameCongregation(request.resource.data);
      allow update: if isAuthenticated() && isSameCongregation(resource.data) && (isModerator() || hasPermission('witnessing', 'edit') || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeUsers', 'status', 'updatedAt', 'currentPublishers']));
      allow delete: if (isModerator() || hasPermission('witnessing', 'delete')) && isSameCongregation(resource.data);
    }

    // 9.1. Pontos de Referência
    // Isolamento: Escritas restritas à mesma congregação.
    match /reference_points/{pointId} {
      allow read: if true; // Permitir leitura pública para que apareça em links compartilhados públicos
      allow create: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(request.resource.data);
      allow update: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(resource.data);
      allow delete: if (isAdmin() || isServant() || hasPermission('referencePoints', 'manage')) && isSameCongregation(resource.data);
    }

    // 10. Miscelânea (Logs, Reports, etc)
    match /notification_templates/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /error_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /security_logs/{id} {
      allow create: if isAuthenticated(); // Requer autenticação (Prevenção de Spam/DoW)
      allow read, update: if isAdmin();
    }

    match /lgpd_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /lgpd_requests/{id} {
      allow create: if isAuthenticated();
      allow read, update: if isAdmin();
    }

    // Fallback: Bloqueia tudo que não foi explicitamente permitido
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
